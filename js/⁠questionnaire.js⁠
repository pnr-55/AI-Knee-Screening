// --- Questionnaire Module ---
const questionsData = [
    { id: 1, text: "มีอาการปวดเข่าเวลาเดินขึ้นหรือลงบันไดหรือไม่?" },
    { id: 2, text: "มีอาการปวดเข่าเวลานั่งยองๆ หรือนั่งพับเพียบหรือไม่?" },
    { id: 3, text: "มีเสียงดังกรอบแกรบในข้อเข่าขณะขยับเคลื่อนไหวหรือไม่?" },
    { id: 4, text: "มีอาการเข่าบวม หรือรู้สึกตึงบริเวณข้อเข่าหรือไม่?" },
    { id: 5, text: "รู้สึกว่าขาโก่งผิดรูป หรือเข่าผิดรูปไปจากเดิมหรือไม่?" },
    { id: 6, text: "เดินได้ระยะทางสั้นลงเนื่องจากมีอาการปวดเข่าหรือไม่?" },
    { id: 7, text: "มีอาการปวดแปล๊บที่ข้อเข่าขณะเดินบนพื้นราบหรือไม่?" },
    { id: 8, text: "ต้องใช้มือพยุงตัวหรือเกาะราวเวลาลุกขึ้นยืนจากเก้าอี้หรือไม่?" }
];

function loadQuestionnaire() {
    const container = document.getElementById('questionnaire-container');
    if (!container) return;

    container.innerHTML = '';

    questionsData.forEach((q, index) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'question-item';
        itemDiv.style.marginBottom = '16px';
        itemDiv.style.padding = '12px';
        itemDiv.style.background = '#f8fafc';
        itemDiv.style.borderRadius = '10px';
        itemDiv.style.border = '1px solid #e2e8f0';

        itemDiv.innerHTML = `
            <p style="font-size: 0.9rem; font-weight: 600; margin-bottom: 8px; color: #1e293b;">
                ${index + 1}. ${q.text}
            </p>
            <div style="display: flex; gap: 20px; font-size: 0.85rem;">
                <label style="cursor: pointer; display: flex; align-items: center; gap: 6px;">
                    <input type="radio" name="q_${q.id}" value="yes" style="accent-color: #0284c7;"> มี (1 คะแนน)
                </label>
                <label style="cursor: pointer; display: flex; align-items: center; gap: 6px;">
                    <input type="radio" name="q_${q.id}" value="no" checked style="accent-color: #0284c7;"> ไม่มี (0 คะแนน)
                </label>
            </div>
        `;
        container.appendChild(itemDiv);
    });
}

function calculateSymptomScore() {
    let score = 0;
    questionsData.forEach(q => {
        const selected = document.querySelector(`input[name="q_${q.id}"]:checked`);
        if (selected && selected.value === 'yes') {
            score += 1; // สะสมคะแนนข้อละ 1 คะแนน
        }
    });
    // แปลงคะแนนเป็นสเกลเต็ม 30 คะแนน
    return Math.round((score / questionsData.length) * 30);
}

document.addEventListener('DOMContentLoaded', () => {
    loadQuestionnaire();
});
