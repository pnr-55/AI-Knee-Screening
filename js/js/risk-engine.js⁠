/**
 * Risk Score Engine (Max 100 Points)
 * Breakdown: Symptom(30) + BMI(20) + Pose(30) + Age(20) = 100
 */

/**
 * คำนวณค่า BMI จากน้ำหนักและส่วนสูง
 */
function calculateBMI(weight, height) {
    if (!weight || !height || height <= 0) return 0;
    const heightInMeters = height / 100;
    const bmi = weight / (heightInMeters * heightInMeters);
    return Math.round(bmi * 100) / 100;
}

/**
 * คำนวณ BMI Score (Max 20 คะแนน)
 * เงื่อนไขพิเศษ: หากอายุต่ำกว่า 20 ปี จะไม่อนุญาตให้นำเกณฑ์ BMI ผู้ใหญ่มาคิดคะแนนอัตโนมัติ
 */
function calculateBMIScore(bmi, age) {
    if (age < 20) {
        return {
            score: 0,
            category: "Needs BMI-for-age Evaluation (Pediatric criteria required)",
            isPediatric: true
        };
    }

    let score = 0;
    let category = "";

    if (bmi < 18.5) {
        score = 5;
        category = "Underweight";
    } else if (bmi >= 18.5 && bmi < 23.0) {
        score = 0;
        category = "Normal Weight";
    } else if (bmi >= 23.0 && bmi < 25.0) {
        score = 10;
        category = "Overweight";
    } else if (bmi >= 25.0 && bmi < 30.0) {
        score = 15;
        category = "Obesity Class I";
    } else {
        score = 20;
        category = "Obesity Class II+";
    }

    return {
        score: score,
        category: category,
        isPediatric: false
    };
}

/**
 * คำนวณ Age Score (Max 20 คะแนน)
 */
function calculateAgeScore(age) {
    if (!age || age <= 0) return 0;

    if (age < 40) {
        return 2;
    } else if (age >= 40 && age < 50) {
        return 6;
    } else if (age >= 50 && age < 60) {
        return 12;
    } else if (age >= 60 && age < 70) {
        return 16;
    } else {
        return 20;
    }
}

/**
 * คำนวณ AI Pose Score (Max 30 คะแนน)
 */
function calculatePoseScore(leftAngle, rightAngle) {
    if (leftAngle === null || rightAngle === null || isNaN(leftAngle) || isNaN(rightAngle)) {
        return 0;
    }

    const leftDeviation = Math.abs(180 - leftAngle);
    const rightDeviation = Math.abs(180 - rightAngle);
    const avgDeviation = (leftDeviation + rightDeviation) / 2;

    let poseScore = (avgDeviation / 25) * 30;
    if (poseScore > 30) poseScore = 30;
    if (poseScore < 0) poseScore = 0;

    return Math.round(poseScore * 100) / 100;
}

/**
 * คำนวณคะแนนความเสี่ยงรวมทั้งหมด (Maximum 100 คะแนน)
 */
function calculateTotalRiskScore(patientData, symptomScore, poseData) {
    const ageScore = calculateAgeScore(patientData.age);
    
    const bmi = calculateBMI(patientData.weight, patientData.height);
    const bmiResult = calculateBMIScore(bmi, patientData.age);
    const bmiScore = bmiResult.score;

    const poseScore = calculatePoseScore(
        poseData ? poseData.leftKneeAngle : null, 
        poseData ? poseData.rightKneeAngle : null
    );

    const validSymptomScore = typeof symptomScore === 'number' ? symptomScore : 0;

    const totalScore = Math.round((validSymptomScore + bmiScore + poseScore + ageScore) * 100) / 100;
    const riskLevel = getRiskLevel(totalScore);

    return {
        symptomScore: validSymptomScore,
        bmiScore: bmiScore,
        bmiValue: bmi,
        bmiCategory: bmiResult.category,
        isPediatricBMI: bmiResult.isPediatric,
        ageScore: ageScore,
        poseScore: poseScore,
        totalScore: totalScore,
        riskLevel: riskLevel
    };
}

/**
 * กำหนดระดับความเสี่ยงจากคะแนนรวม
 */
function getRiskLevel(totalScore) {
    if (totalScore <= 30) {
        return { level: "Low Risk", description: "มีความเสี่ยงต่ำต่อภาวะข้อเข่าเสื่อมและขาโก่ง", color: "#2ecc71" };
    } else if (totalScore > 30 && totalScore <= 60) {
        return { level: "Moderate Risk", description: "มีความเสี่ยงระดับปานกลาง ควรสังเกตอาการและปรับพฤติกรรม", color: "#f39c12" };
    } else {
        return { level: "High Risk", description: "มีความเสี่ยงสูง ควรปรึกษาแพทย์ผู้เชี่ยวชาญเพื่อตรวจวินิจฉัยเชิงลึก", color: "#e74c3c" };
    }
}
