/**
 * Questionnaire System & Symptom Score Calculation (Max 30 points)
 */

// รายการแบบสอบถาม 8 ข้อ (ตัวอย่างข้อคำถามคัดกรองอาการข้อเข่า)
const questionnaireQuestions = [
    { id: 1, text: "1. ท่านมีอาการปวดข้อเข่าบ่อยแค่ไหนในช่วง 1 เดือนที่ผ่านมา?", weight: 4 },
    { id: 2, text: "2. มีอาการปวดมากขึ้นเมื่อต้องเดินขึ้น-ลงบันได หรือลุกขึ้นยืนจากท่านั่งหรือไม่?", weight: 4 },
    { id: 3, text: "3. ได้ยินเสียงกรอบแกรบ หรือรู้สึกสะดุด/ติดขัดบริเวณข้อเข่าขณะเคลื่อนไหวหรือไม่?", weight: 4 },
    { id: 4, text: "4. มีอาการข้อเข่าบวม แดง หรือรู้สึกร้อนบริเวณข้อเข่าเป็นครั้งคราวหรือไม่?", weight: 4 },
    { id: 5, text: "5. รู้สึกข้อเข่าไม่มั่นคง ทรงตัวได้ไม่ดี หรือรู้สึกเหมือนเข่าจะทรุดเวลาเดินหรือไม่?", weight: 4 },
    { id: 6, text: "6. มีข้อจำกัดในการยืดเหยียดขาให้สุด หรือไม่สามารถงอเข่าได้สุดเหมือนปกติหรือไม่?", weight: 3 },
    { id: 7, text: "7. อาการปวดข้อเข่ารบกวนกิจวัตรประจำวัน เช่น การเดินระยะไกล หรือการทำงานหรือไม่?", weight: 4 },
    { id: 8, text: "8. ท่านเคยมีประวัติได้รับบาดเจ็บรุนแรงที่ข้อเข่ามาก่อนหน้านี้หรือไม่?", weight: 3 }
    // รวมน้ำหนักคะแนนรวมสูงสุด = 4+4+4+4+4+3+4+3 = 30 คะแนน
];

/**
 * เรนเดอร์คำถามลงใน HTML Container
 */
function renderQuestionnaire() {
    const container = document.getElementById('questionnaire-container');
    if (!container) return;

    let html = '';
    questionnaireQuestions.forEach((q, index) => {
        html += `
            <div class="question-card" style="background: #f8fafc; padding: 12px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0;">
                <p style="font-size: 0.9rem; font-weight: 600; margin-bottom: 8px; color: #2c3e50;">${q.text}</p>
                <div style="display: flex; gap: 16px; font-size: 0.85rem;">
                    <label><input type="radio" name="q_${q.id}" value="0"> ไม่มี / ไม่ใช่</label>
                    <label><input type="radio" name="q_${q.id}" value="1"> มีเล็กน้อย / เป็นบางครั้ง</label>
                    <label><input type="radio" name="q_${q.id}" value="2"> มีมาก / เป็นประจำ</label>
                </div>
            </div>
        `;
    });
    container.innerHTML = html;
}

/**
 * คำนวณ Symptom Score (สูงสุด 30 คะแนน)
 * โดยประเมินจากน้ำหนักคะแนนของแต่ละข้อคูณกับระดับความรุนแรงที่ตอบ
 */
function calculateSymptomScore() {
    let rawScoreSum = 0;
    let maxRawPossible = 0;
    const answers = [];

    questionnaireQuestions.forEach(q => {
        const radios = document.querySelectorAll(`input[name="q_${q.id}"]:checked`);
        let val = 0;
        if (radios.length > 0) {
            val = parseInt(radios[0].value, 10);
        }
        answers.push({ id: q.id, answerValue: val });

        rawScoreSum += (val * q.weight);
        maxRawPossible += (2 * q.weight); // คะแนนสูงสุดต่อข้อคือ 2
    });

    // เทียบบัญญัติไตรยางค์ให้คะแนนเต็มอยู่ที่ 30 คะแนน
    const symptomScore = maxRawPossible > 0 ? (rawScoreSum / maxRawPossible) * 30 : 0;
    
    return {
        score: Math.round(symptomScore * 100) / 100, // ปัดเศษ 2 ตำแหน่ง
        answers: answers
    };
}

/**
 * ตรวจสอบว่าผู้ใช้ตอบครบทุกข้อหรือยัง
 */
function validateQuestionnaireCompletion() {
    for (let q of questionnaireQuestions) {
        const radios = document.querySelectorAll(`input[name="q_${q.id}"]:checked`);
        if (radios.length === 0) {
            return false;
        }
    }
    return true;
}
