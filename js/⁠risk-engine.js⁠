// --- Risk Engine & Score Calculation Module ---
function calculateFinalScore() {
    // 1. ดึงคะแนนจากแบบสอบถาม (Symptom Score เต็ม 30)
    let symptomScore = 0;
    if (typeof calculateSymptomScore === 'function') {
        symptomScore = calculateSymptomScore();
    }

    // 2. คำนวณ BMI Score (เต็ม 20)
    const weight = parseFloat(document.getElementById('input-weight')?.value) || 60;
    const heightCm = parseFloat(document.getElementById('input-height')?.value) || 170;
    const heightM = heightCm / 100;
    const bmi = weight / (heightM * heightM);
    
    let bmiScore = 0;
    if (bmi >= 30) bmiScore = 20;
    else if (bmi >= 25) bmiScore = 15;
    else if (bmi >= 23) bmiScore = 10;
    else bmiScore = 5;

    // 3. คะแนนโครงสร้างขาจาก AI Camera (Pose Score เต็ม 30)
    let poseScore = 20; // ค่าเริ่มต้นมาตรฐาน
    if (typeof latestPoseData !== 'undefined' && latestPoseData.alignmentScore) {
        poseScore = latestPoseData.alignmentScore;
    }

    // 4. คะแนนตามช่วงวัย (Age Score เต็ม 20)
    const age = parseInt(document.getElementById('input-age')?.value) || 40;
    let ageScore = 5;
    if (age >= 60) ageScore = 20;
    else if (age >= 50) ageScore = 15;
    else if (age >= 40) ageScore = 10;

    // รวมคะแนนทั้งหมด (เต็ม 100)
    const totalScore = symptomScore + bmiScore + poseScore + ageScore;

    // แสดงผลลงในหน้า Result Screen
    document.getElementById('res-total-score').innerText = `${totalScore} / 100`;
    document.getElementById('detail-symptom').innerText = symptomScore;
    document.getElementById('detail-bmi').innerText = bmiScore;
    document.getElementById('detail-bmi-val').innerText = `BMI: ${bmi.toFixed(1)}`;
    document.getElementById('detail-pose').innerText = poseScore;
    document.getElementById('detail-age').innerText = ageScore;

    const riskBadge = document.getElementById('res-risk-level');
    const riskDesc = document.getElementById('res-risk-desc');
    const btnGotoReferral = document.getElementById('btn-goto-referral');

    if (totalScore >= 60) {
        riskBadge.innerText = 'ความเสี่ยงสูง (High Risk)';
        riskBadge.style.background = '#ef4444';
        riskDesc.innerText = 'พบสัญญาณความเสี่ยงข้อเข่าเสื่อมหรือโครงสร้างผิดปกติค่อนข้างมาก แนะนำให้พบแพทย์เพื่อวินิจฉัย';
        if (btnGotoReferral) btnGotoReferral.style.display = 'inline-block';
    } else if (totalScore >= 35) {
        riskBadge.innerText = 'ความเสี่ยงปานกลาง (Moderate Risk)';
        riskBadge.style.background = '#f59e0b';
        riskDesc.innerText = 'เริ่มมีข้อบ่งชี้ความเสี่ยง ควรปรับพฤติกรรมการใช้งานข้อเข่าและหลีกเลี่ยงการนั่งยองๆ';
        if (btnGotoReferral) btnGotoReferral.style.display = 'none';
    } else {
        riskBadge.innerText = 'ความเสี่ยงต่ำ (Low Risk)';
        riskBadge.style.background = '#10b981';
        riskDesc.innerText = 'โครงสร้างและอาการอยู่ในเกณฑ์ปกติ หมั่นดูแลสุขภาพและออกกำลังกายอย่างสม่ำเสมอ';
        if (btnGotoReferral) btnGotoReferral.style.display = 'none';
    }
}
